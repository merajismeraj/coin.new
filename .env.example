# API
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coinnew
PORT=4000
CHECKOUT_BASE_URL=http://localhost:3001
# Dashboard + checkout (server-side only)
API_URL=http://localhost:4000

# Phase 2 — on-chain payments
NETWORK=testnet                     # testnet | mainnet (API and worker)
NEXT_PUBLIC_NETWORK=testnet         # checkout; must match NETWORK
# RPC_URL_ETHEREUM= / RPC_URL_BASE= / RPC_URL_POLYGON= / RPC_URL_SOLANA=   (defaults: public RPCs; use a provider in production)
ALCHEMY_SIGNING_KEYS=               # comma-separated, one per Alchemy Address Activity webhook
HELIUS_AUTH_HEADER=                 # value configured as the Helius webhook's Authorization header
CHAINALYSIS_API_KEY=                # free sanctions screening API; recommended
SANCTIONS_DENYLIST=                 # extra comma-separated addresses to block
SCREENING_FAIL_CLOSED=0             # 1 = block payments when screening is unreachable
TRUSTED_PROXIES=127.0.0.1           # IPs/CIDRs of the checkout app, which proxies buyer requests
WEBHOOKS_ALLOW_PRIVATE=0            # 1 only for local webhook testing
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SOLANA_RPC_URL=
