# API
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coinnew
PORT=4000
CHECKOUT_BASE_URL=http://localhost:3001
# Dashboard + checkout (server-side only)
API_URL=http://localhost:4000

# Phase 2 — on-chain payments
NETWORK=testnet                     # testnet | mainnet (API and worker)
NEXT_PUBLIC_NETWORK=testnet         # checkout; must match NETWORK
ALCHEMY_API_KEY=                    # one key → RPC for Ethereum, Base, Polygon, Solana (enable each network on the Alchemy app)
# RPC_URL_ETHEREUM= / RPC_URL_BASE= / RPC_URL_POLYGON= / RPC_URL_SOLANA=   (override per chain; defaults: public RPCs)
ALCHEMY_SIGNING_KEYS=               # optional: keys of webhooks you manage by hand (auto-managed ones are stored in the DB)
ALCHEMY_AUTH_TOKEN=                 # Notify API auth token (dashboard → Webhooks); enables automatic address registration
PUBLIC_API_URL=                     # public base URL of this API, e.g. https://api.coin.new (Alchemy delivers webhooks here)
HELIUS_AUTH_HEADER=                 # value configured as the Helius webhook's Authorization header
CHAINALYSIS_API_KEY=                # free sanctions screening API; recommended
SANCTIONS_DENYLIST=                 # extra comma-separated addresses to block
SCREENING_FAIL_CLOSED=0             # 1 = block payments when screening is unreachable
TRUSTED_PROXIES=127.0.0.1           # IPs/CIDRs of the checkout app, which proxies buyer requests
WEBHOOKS_ALLOW_PRIVATE=0            # 1 only for local webhook testing
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SOLANA_RPC_URL=

# Phase 3 — licensed partner rails
BRIDGE_API_KEY=
BRIDGE_API_URL=                     # default: sandbox on testnet, production on mainnet
BRIDGE_WEBHOOK_PUBLIC_KEY=          # PEM from Bridge's webhook endpoint (\n-escaped is fine)
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=                 # signs widget URLs
MOONPAY_WEBHOOK_KEY=

# Phase 4 — email and links
RESEND_API_KEY=                     # unset = emails are logged, not sent
EMAIL_FROM="coin.new <billing@your-domain>"
DASHBOARD_URL=http://localhost:3000
